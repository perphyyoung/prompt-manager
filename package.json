{
  "name": "prompt-manager",
  "version": "0.9.9",
  "description": "本地提示词管理工具",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.18.0",
    "js": "ES2023",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "Electron 28.0"
  ],
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run check:constants && electron-vite build",
    "check": "npm run check:constants && npm run typecheck && npm run lint",
    "check:constants": "tsx scripts/check-constants.ts",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "prompt",
    "manager"
  ],
  "author": "py",
  "license": "GPL-3.0",
  "build": {
    "files": [
      "out/**/*",
      "assets/**/*",
      "locales/en-US.pak",
      "locales/zh-CN.pak"
    ],
    "icon": "assets/icon.ico",
    "publish": null,
    "win": {
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PromptManager",
      "runAfterFinish": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "sharp": "^0.33.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "happy-dom": "^20.8.4",
    "knip": "^6.4.1",
    "oxlint": "^1.62.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.4"
  }
}
