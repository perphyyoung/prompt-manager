{
  "name": "prompt-manager",
  "version": "0.11.72",
  "description": "本地提示词管理工具",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "js": "ES2023"
  },
  "browserslist": [
    "Electron 41.0"
  ],
  "scripts": {
    "start": "electron-vite preview",
    "dev": "pnpm run build && electron-vite dev",
    "build": "pnpm run check:constants && electron-vite build",
    "check": "pnpm run check:constants && pnpm run typecheck && pnpm run lint",
    "check:all": "pnpm run check:constants && pnpm run typecheck && pnpm run lint && sentrux check .",
    "check:constants": "tsx scripts/check-constants.ts",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "release": "pnpm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "prompt",
    "manager"
  ],
  "author": "py",
  "license": "GPL-3.0",
  "build": {
    "appId": "com.prompt-manager.app",
    "productName": "Prompt Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "locales/en-US.pak",
      "locales/zh-CN.pak"
    ],
    "icon": "assets/icon.ico",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@img/sharp-win32-x64": "^0.35.1",
    "electron-log": "^5.4.3",
    "sharp": "^0.35.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.0",
    "electron": "41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "happy-dom": "^20.8.4",
    "knip": "^6.4.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
