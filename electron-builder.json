{
  "appId": "com.promptmanager.app",
  "productName": "PromptManager",
  "directories": {
    "output": "dist"
  },
  "files": [
    "out/**/*",
    "assets/**/*",
    "config.json"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "msi",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "signAndEditExecutable": false,
    "executableName": "PromptManager"
  },
  "msi": {
    "artifactName": "${productName}-${version}-setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "menuCategory": false
  }
}
